{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "types",
    "index.ts",
    "capability-catalog.ts",
    "src",
    "test",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
